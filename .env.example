NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase projects. ANON_KEY remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CREWOS_WORKER_SECRET=
# Vercel Cron envia este valor como Bearer token quando configurado no projeto.
CRON_SECRET=
# Em produção, o modo demo fica bloqueado por padrão. Habilite apenas em previews controlados.
CREWOS_ALLOW_DEMO=false
# Optional model routing overrides
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_COMPLEX=gpt-5.6-sol
